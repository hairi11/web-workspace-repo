<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.company.web</groupId>
        <artifactId>module-web</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>module-web-webapp</artifactId>
    <packaging>war</packaging>

    <!-- Reactor dependencies: ensure feature modules build before the final WAR -->
    <dependencies>
        <dependency>
            <groupId>com.company.web</groupId>
            <artifactId>user-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.company.web</groupId>
            <artifactId>todos-module</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>module-web</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven.antrun.version}</version>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <configuration>
                            <target>
                                <exec executable="${npm.executable}"
                                      dir="${project.basedir}"
                                      failonerror="true">
                                    <env key="PATH" value="${node.home};${env.PATH}"/>
                                    <arg value="install"/>
                                </exec>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <configuration>
                            <target>
                                <exec executable="${npm.executable}"
                                      dir="${project.basedir}"
                                      failonerror="true">
                                    <env key="PATH" value="${node.home};${env.PATH}"/>
                                    <arg value="run"/>
                                    <arg value="build"/>
                                </exec>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>10.0.26</version>
                <configuration>
                    <webApp>
                        <contextPath>/module-web</contextPath>
                    </webApp>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven.war.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>

                    <!-- Do not package the resource-module JARs into WEB-INF/lib. -->
                    <packagingExcludes>
                        WEB-INF/lib/user-module-*.jar,
                        WEB-INF/lib/todos-module-*.jar
                    </packagingExcludes>

                    <!-- npm build creates dist/module-web.
                         Copy its CONTENTS to WAR root. -->
                    <webResources>
                        <resource>
                            <directory>${project.basedir}/dist/module-web</directory>
                            <targetPath>/</targetPath>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
